# .env.example - Environment Configuration Template

# CI_ENVIRONMENT determines whether to show error suppression
CI_ENVIRONMENT = development

# Application Settings
app.baseURL = 'http://lwando.tender-notifications.co.za/'
app.indexPage = 
app.forceGlobalSecureRequests = false
app.sessionDriver = files
app.sessionCookieName = CITSESSID
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false
app.CSRFProtection = true
app.CSRFTokenRandomize = false
app.CSRFHeaderName = X-CSRF-TOKEN
app.contentSecurityPolicy = false

# Database Configuration
db.default.hostname = localhost
db.default.username = root
db.default.password = 
db.default.database = tender_notifications
db.default.DBDriver = MySQLi
db.default.DBPrefix = 
db.default.port = 3306

# Email Configuration
email.protocol = smtp
email.SMTPHost = smtp.mailtrap.io
email.SMTPPort = 465
email.SMTPEncrypto = ssl
email.SMTPUser = your_mailtrap_user
email.SMTPPass = your_mailtrap_password
email.from = noreply@govtenders.local
email.fromName = "Government Tenders"

# Treasury API Configuration
TREASURY_API_URL = https://ocds-api.etenders.gov.za/api/OCDSReleases?PageSize=200&dateFrom=2024-01-01&dateTo=2024-03-31
TREASURY_API_KEY = your_api_key_here

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVER_KEY = your_fcm_server_key

# SMS Provider Configuration (Bulk SMS)
SMS_PROVIDER = bulk-sms
BULKSMS_USERNAME = your_username
BULKSMS_PASSWORD = your_password

# Logging
log.threshold = 4
log.dateFormat = "Y-m-d H:i:s"
log.logDeprecations = true
log.logNormalized = true
log.logRawData = false
log.standardizeLineEndings = true

# Security
encryption.key = 
encryption.driver = OpenSSL
